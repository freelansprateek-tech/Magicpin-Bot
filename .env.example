# Copy this file to .env and fill in real values.
# NEVER commit .env — it is listed in .gitignore.
# On Render / Railway / Fly, set the same variables in the platform's dashboard instead.

# ---- Server ----
PORT=8080
LOG_LEVEL=info

# ---- Bot identity (returned by GET /v1/metadata) ----
BOT_TEAM_NAME=Your Team Name
BOT_TEAM_MEMBERS=Your Full Name
BOT_CONTACT_EMAIL=you@example.com
BOT_VERSION=1.0.0
BOT_SUBMITTED_AT=2026-09-27T00:00:00Z

# ---- LLM provider ----
# One of: openai | anthropic | none   ("none" = deterministic templates only)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=8
LLM_MAX_PARALLEL=8

# ---- Response cache ----
CACHE_DIR=cache

# ---- Local judge simulator only (starter/judge_simulator.py) ----
# Key falls back to OPENAI_API_KEY above. Scenarios: all | full_evaluation | warmup |
# phase2_short | auto_reply_hell | intent_transition | hostile
JUDGE_LLM_PROVIDER=openai
JUDGE_LLM_MODEL=gpt-4o-mini
JUDGE_SCENARIO=all
JUDGE_SIM_NOW=2026-04-26T10:30:00Z
JUDGE_BOT_URL=http://localhost:8080
